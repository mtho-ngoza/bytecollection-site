---
const valueProps = [
  {
    title: "CIPC Registered",
    description: "Officially registered in South Africa. A legitimate, accountable business partner.",
    icon: "shield",
    color: "blue",
  },
  {
    title: "Global Reach",
    description: "Serving clients across multiple time zones. Global deployment, local understanding.",
    icon: "globe",
    color: "purple",
  },
  {
    title: "Modern Tech Stack",
    description: "We use the latest frameworks and tools to build fast, scalable, and maintainable applications.",
    icon: "bolt",
    color: "cyan",
  },
];
---

<section id="about" class="py-24 px-6 section-divider">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div>
        <span class="text-blue-500 text-sm font-medium tracking-wider uppercase">
          About Us
        </span>
        <h2 class="text-4xl md:text-5xl font-bold mt-4 mb-6">
          Built in South Africa, Serving the World
        </h2>
        <p class="text-gray-400 leading-relaxed mb-6">
          Byte Collection was founded with a clear mission: to bring world-class
          software development to businesses that want to grow, without the
          enterprise price tag.
        </p>
        <p class="text-gray-400 leading-relaxed mb-6">
          As a CIPC-registered company based in South Africa, we combine local
          understanding with global standards. We serve clients across South
          Africa and beyond, delivering solutions that compete with agencies
          anywhere in the world.
        </p>
        <p class="text-gray-400 leading-relaxed mb-8">
          Our approach is simple: understand your business first, then build
          technology that serves it. No unnecessary complexity. No
          overengineering. Just clean, effective solutions.
        </p>

        <!-- Founder Info -->
        <div class="flex items-center gap-4 p-4 glass-card rounded-xl">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-xl font-bold">
            MM
          </div>
          <div>
            <div class="font-semibold">Mthobisi Mthembu</div>
            <div class="text-gray-500 text-sm">Founder & Lead Developer</div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        {valueProps.map((prop) => (
          <div class="glass-card rounded-xl p-6 hover:border-gray-600 transition-all duration-300">
            <div class="flex items-start gap-4">
              <div class={`w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0 ${
                prop.color === "blue"
                  ? "bg-blue-600/20"
                  : prop.color === "purple"
                  ? "bg-purple-600/20"
                  : "bg-cyan-600/20"
              }`}>
                {prop.icon === "shield" && (
                  <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {prop.icon === "globe" && (
                  <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {prop.icon === "bolt" && (
                  <svg class="w-6 h-6 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
              </div>
              <div>
                <h4 class="font-semibold mb-1">{prop.title}</h4>
                <p class="text-gray-400 text-sm">{prop.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
