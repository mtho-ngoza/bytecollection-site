---
const experience = [
  {
    company: "WesBank",
    role: "Senior Software Engineer",
    period: "2025 – Present",
    description: "Legacy replacement initiative. Spring Boot, Spring Batch, Java 21. Increased test coverage from 0% to 70%.",
    color: "blue",
  },
  {
    company: "BMW South Africa",
    role: "Software Developer / Team Lead",
    period: "2022 – 2025",
    description: "Vehicle Stock Management. Java 21, Quarkus, Kafka, MongoDB, AWS. 30% faster response times.",
    color: "purple",
  },
  {
    company: "FNB South Africa",
    role: "Full Stack Developer",
    period: "2019 – 2022",
    description: "Business Profile, My Profile, Trade Applications. Java, Spring Boot, Angular, SQL Server.",
    color: "cyan",
  },
];

const credentials = [
  { label: "AWS Certified Cloud Practitioner", year: "2024" },
  { label: "BSc Computer Science", year: "UKZN" },
  { label: "CIPC Registered", year: "2023" },
];
---

<section id="about" class="py-24 px-6 section-divider">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-2 gap-16 items-start">
      <div>
        <span class="text-blue-500 text-sm font-medium tracking-wider uppercase">
          Enterprise Background
        </span>
        <h2 class="text-4xl md:text-5xl font-bold mt-4 mb-6">
          7+ Years in Banking & Automotive
        </h2>
        <p class="text-gray-400 leading-relaxed mb-6">
          Before Byte Collection, the engineering experience came from some of South Africa's
          most demanding enterprise environments: BMW's vehicle systems, WesBank's financial
          platforms, and FNB's customer-facing applications.
        </p>
        <p class="text-gray-400 leading-relaxed mb-6">
          This background means your project gets enterprise-grade engineering practices —
          proper testing, clean architecture, production reliability — without enterprise
          bureaucracy or pricing.
        </p>
        <p class="text-gray-400 leading-relaxed mb-8">
          Byte Collection operates with a core team of 4 — the founder, 2 developers
          and admin support — backed by an extended network of senior developers and
          QA specialists. You work directly with the founder, with the capacity to
          scale when your project demands it.
        </p>

        <!-- Founder Info -->
        <div class="flex items-center gap-4 p-5 glass-card rounded-xl mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-xl font-bold overflow-hidden">
            <!-- Replace with actual image: <img src="/images/mthobisi.jpg" alt="Mthobisi Mthembu" class="w-full h-full object-cover" /> -->
            MM
          </div>
          <div>
            <div class="font-semibold">Mthobisi Mthembu</div>
            <div class="text-gray-500 text-sm">Founder & Lead Engineer</div>
          </div>
        </div>

        <!-- Credentials -->
        <div class="flex flex-wrap gap-3">
          {credentials.map((cred) => (
            <span class="text-sm bg-gray-800/50 border border-gray-700 text-gray-300 px-4 py-2 rounded-full">
              {cred.label} <span class="text-gray-500">• {cred.year}</span>
            </span>
          ))}
        </div>
      </div>

      <div class="space-y-6">
        <h3 class="text-lg font-semibold text-gray-300 mb-4">Experience Timeline</h3>
        {experience.map((exp, index) => (
          <div class="glass-card rounded-xl p-6 hover:border-gray-600 transition-all duration-300 relative">
            {index < experience.length - 1 && (
              <div class="absolute left-9 top-full w-0.5 h-6 bg-gray-800 -translate-x-1/2" />
            )}
            <div class="flex items-start gap-4">
              <div class={`w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0 ${
                exp.color === "blue"
                  ? "bg-blue-600/20"
                  : exp.color === "purple"
                  ? "bg-purple-600/20"
                  : "bg-cyan-600/20"
              }`}>
                <svg class={`w-6 h-6 ${
                  exp.color === "blue" ? "text-blue-500" : exp.color === "purple" ? "text-purple-500" : "text-cyan-500"
                }`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <h4 class="font-semibold">{exp.company}</h4>
                  <span class="text-xs text-gray-500">{exp.period}</span>
                </div>
                <div class="text-sm text-gray-400 mb-2">{exp.role}</div>
                <p class="text-gray-500 text-sm">{exp.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
