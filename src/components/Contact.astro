---
// Get your Formspree form ID from https://formspree.io
const FORMSPREE_ID = "xpwzgqpr"; // Replace with your actual Formspree ID
---

<section id="contact" class="py-24 px-6 bg-gradient-to-b from-gray-900/50 to-gray-950 section-divider">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-4xl md:text-5xl font-bold mb-6">
      Let's Discuss Your Project
    </h2>
    <p class="text-gray-400 text-xl mb-4">
      Whether you need an MVP built, a legacy system modernised, or senior engineering
      capacity for your team — let's talk.
    </p>
    <p class="text-gray-500 text-sm mb-10">
      Best for: MVP builds, integration projects, backend engineering, technical advisory
    </p>

    <div class="glass-card rounded-2xl p-10 max-w-2xl mx-auto">
      <form
        action={`https://formspree.io/f/${FORMSPREE_ID}`}
        method="POST"
        class="space-y-6"
      >
        <div class="grid md:grid-cols-2 gap-6">
          <input
            type="text"
            name="name"
            placeholder="Your Name"
            required
            class="w-full bg-gray-800/50 border border-gray-700 rounded-xl px-5 py-4 text-white placeholder-gray-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all duration-200"
          />
          <input
            type="email"
            name="email"
            placeholder="Your Email"
            required
            class="w-full bg-gray-800/50 border border-gray-700 rounded-xl px-5 py-4 text-white placeholder-gray-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all duration-200"
          />
        </div>
        <select
          name="project-type"
          required
          class="w-full bg-gray-800/50 border border-gray-700 rounded-xl px-5 py-4 text-white focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all duration-200"
        >
          <option value="" disabled selected class="text-gray-500">What do you need?</option>
          <option value="mvp">MVP / New Product Build</option>
          <option value="integration">Integration / API Development</option>
          <option value="modernisation">Legacy Modernisation</option>
          <option value="backend">Backend Engineering</option>
          <option value="advisory">Technical Advisory / Code Review</option>
          <option value="other">Other</option>
        </select>
        <textarea
          name="message"
          placeholder="Tell us about your project, timeline, and any specific requirements..."
          rows="5"
          required
          class="w-full bg-gray-800/50 border border-gray-700 rounded-xl px-5 py-4 text-white placeholder-gray-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all duration-200 resize-none"
        ></textarea>
        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-xl font-medium transition-all duration-200 glow hover:scale-[1.02]"
        >
          Send Message
        </button>
      </form>

      <div class="mt-8 pt-8 border-t border-gray-800">
        <p class="text-gray-500 text-sm mb-4">Or reach out directly:</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8">
          <a
            href="tel:+27840817668"
            class="flex items-center gap-2 text-gray-300 hover:text-white transition-colors duration-200"
          >
            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            084 081 7668
          </a>
          <a
            href="mailto:mthobisi@bytecollection.co.za"
            class="flex items-center gap-2 text-blue-500 hover:text-blue-400 transition-colors duration-200"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            mthobisi@bytecollection.co.za
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
