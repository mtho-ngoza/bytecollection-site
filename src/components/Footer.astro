---
const currentYear = new Date().getFullYear();

const services = [
  { label: "Production Applications", href: "#services" },
  { label: "Backend Systems & APIs", href: "#services" },
  { label: "Integrations", href: "#services" },
  { label: "Technical Advisory", href: "#services" },
];

const company = [
  { label: "Case Study", href: "#work" },
  { label: "Experience", href: "#about" },
  { label: "Process", href: "#process" },
  { label: "Contact", href: "#contact" },
];
---

<footer class="py-12 px-6 border-t border-gray-800">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-4 gap-10 mb-10">
      <div>
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center font-bold text-xl">
            B
          </div>
          <span class="text-xl font-semibold">Byte Collection</span>
        </a>
        <p class="text-gray-500 text-sm mb-4">
          Enterprise-grade software engineering for growing businesses.
          Full-stack development from concept to production.
        </p>
        <div class="flex items-center gap-4">
          <a
            href="https://github.com/mtho-ngoza"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-white transition-colors duration-200"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
          <a
            href="https://linkedin.com/in/mthobisi-mthembu"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-white transition-colors duration-200"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Services</h4>
        <ul class="space-y-2 text-sm text-gray-500">
          {services.map((item) => (
            <li>
              <a href={item.href} class="hover:text-white transition-colors duration-200">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Company</h4>
        <ul class="space-y-2 text-sm text-gray-500">
          {company.map((item) => (
            <li>
              <a href={item.href} class="hover:text-white transition-colors duration-200">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Contact</h4>
        <ul class="space-y-3 text-sm text-gray-500">
          <li>
            <a href="tel:+27840817668" class="hover:text-white transition-colors duration-200">
              084 081 7668
            </a>
          </li>
          <li>
            <a href="mailto:mthobisi@bytecollection.co.za" class="hover:text-white transition-colors duration-200">
              mthobisi@bytecollection.co.za
            </a>
          </li>
          <li class="pt-2 border-t border-gray-800">
            <span class="text-gray-600">Noordwyk, Gauteng</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-gray-500 text-sm text-center md:text-left">
        <p>&copy; {currentYear} Byte Collection (Pty) Ltd. All rights reserved.</p>
        <p class="text-gray-600 mt-1">CIPC Reg: 2023/251512/07 | AWS Certified</p>
      </div>
      <div class="flex items-center gap-4 text-xs text-gray-600">
        <span>Private Company</span>
        <span>•</span>
        <span>Est. December 2023</span>
      </div>
    </div>
  </div>
</footer>
