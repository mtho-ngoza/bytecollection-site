---
const steps = [
  {
    number: "1",
    title: "Discovery",
    description: "Understand the problem before proposing solutions. A call or two to clarify requirements, constraints, and success criteria.",
    color: "blue",
  },
  {
    number: "2",
    title: "Scope & Quote",
    description: "Clear deliverables, acceptance criteria, and pricing. No surprises. Paid discovery phase for complex projects.",
    color: "purple",
  },
  {
    number: "3",
    title: "Build",
    description: "Regular working software over documentation. Weekly updates, direct communication, and the ability to course-correct early.",
    color: "cyan",
  },
  {
    number: "4",
    title: "Ship & Support",
    description: "Production deployment with proper testing, documentation, and optional ongoing maintenance agreements.",
    color: "green",
  },
];
---

<section id="process" class="py-24 px-6 bg-gray-900/50 section-divider">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="text-blue-500 text-sm font-medium tracking-wider uppercase">
        How We Work
      </span>
      <h2 class="text-4xl md:text-5xl font-bold mt-4">Direct, No Layers</h2>
      <p class="text-gray-400 mt-4 max-w-2xl mx-auto">
        You work directly with the engineer building your project. No account managers,
        no handoffs, no telephone game.
      </p>
    </div>

    <div class="grid md:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="text-center group">
          <div class={`w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl font-bold transition-transform duration-300 group-hover:scale-110 ${
            step.color === "blue"
              ? "bg-blue-600/20 text-blue-500"
              : step.color === "purple"
              ? "bg-purple-600/20 text-purple-500"
              : step.color === "cyan"
              ? "bg-cyan-600/20 text-cyan-500"
              : "bg-green-600/20 text-green-500"
          }`}>
            {step.number}
          </div>
          <h4 class="font-semibold mb-2">{step.title}</h4>
          <p class="text-gray-400 text-sm">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
