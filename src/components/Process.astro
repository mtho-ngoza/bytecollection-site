---
const steps = [
  {
    number: "1",
    title: "Discovery",
    description: "We learn about your business, goals, and challenges through in-depth conversations.",
    color: "blue",
  },
  {
    number: "2",
    title: "Planning",
    description: "We create a detailed roadmap with clear milestones and deliverables you can track.",
    color: "purple",
  },
  {
    number: "3",
    title: "Development",
    description: "We build your solution with regular updates and opportunities for feedback.",
    color: "cyan",
  },
  {
    number: "4",
    title: "Launch & Support",
    description: "We deploy your project and provide ongoing support to ensure continued success.",
    color: "green",
  },
];
---

<section id="process" class="py-24 px-6 bg-gray-900/50 section-divider">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="text-blue-500 text-sm font-medium tracking-wider uppercase">
        Our Process
      </span>
      <h2 class="text-4xl md:text-5xl font-bold mt-4">How We Work</h2>
      <p class="text-gray-400 mt-4 max-w-2xl mx-auto">
        A transparent, collaborative process that keeps you informed every step
        of the way.
      </p>
    </div>

    <div class="grid md:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="text-center group">
          <div class={`w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl font-bold transition-transform duration-300 group-hover:scale-110 ${
            step.color === "blue"
              ? "bg-blue-600/20 text-blue-500"
              : step.color === "purple"
              ? "bg-purple-600/20 text-purple-500"
              : step.color === "cyan"
              ? "bg-cyan-600/20 text-cyan-500"
              : "bg-green-600/20 text-green-500"
          }`}>
            {step.number}
          </div>
          <h4 class="font-semibold mb-2">{step.title}</h4>
          <p class="text-gray-400 text-sm">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
