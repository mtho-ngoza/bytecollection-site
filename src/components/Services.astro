---
const services = [
  {
    title: "Production Applications",
    description:
      "Full-stack products from idea to deployment. We build applications that handle real users, real payments, and real scale — not prototypes that need rebuilding.",
    features: ["MVP Development", "SaaS Platforms", "E-commerce & Marketplaces"],
    icon: "rocket",
    color: "blue",
  },
  {
    title: "Backend Systems & APIs",
    description:
      "Robust backend engineering using Java, Spring Boot, Quarkus, and Node.js. Microservices, event-driven architectures, and APIs built for reliability.",
    features: ["REST & GraphQL APIs", "Event-Driven Systems", "Database Design"],
    icon: "server",
    color: "purple",
  },
  {
    title: "Integrations & Modernisation",
    description:
      "Connect existing systems, replace legacy components, and modernise your technology stack incrementally without disrupting operations.",
    features: ["Payment Gateways", "Legacy Migration", "Third-Party APIs"],
    icon: "link",
    color: "cyan",
  },
  {
    title: "Technical Advisory",
    description:
      "Architecture reviews, code audits, and engineering standards. Bring enterprise-grade practices to your development team.",
    features: ["Architecture Design", "Code Reviews", "Testing Strategy"],
    icon: "lightbulb",
    color: "amber",
  },
];

const colorClasses = {
  blue: {
    bg: "bg-blue-600/20",
    bgHover: "group-hover:bg-blue-600/30",
    text: "text-blue-500",
    border: "hover:border-blue-500/30",
  },
  purple: {
    bg: "bg-purple-600/20",
    bgHover: "group-hover:bg-purple-600/30",
    text: "text-purple-500",
    border: "hover:border-purple-500/30",
  },
  cyan: {
    bg: "bg-cyan-600/20",
    bgHover: "group-hover:bg-cyan-600/30",
    text: "text-cyan-500",
    border: "hover:border-cyan-500/30",
  },
  amber: {
    bg: "bg-amber-600/20",
    bgHover: "group-hover:bg-amber-600/30",
    text: "text-amber-500",
    border: "hover:border-amber-500/30",
  },
};
---

<section id="services" class="py-24 px-6 section-divider">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="text-blue-500 text-sm font-medium tracking-wider uppercase">
        What We Build
      </span>
      <h2 class="text-4xl md:text-5xl font-bold mt-4">Engineering That Ships</h2>
      <p class="text-gray-400 mt-4 max-w-2xl mx-auto">
        From MVPs to enterprise integrations. Production-ready software with the quality
        standards of BMW, WesBank, and FNB.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => {
        const colors = colorClasses[service.color as keyof typeof colorClasses];
        return (
          <div class={`glass-card rounded-2xl p-8 transition-all duration-300 group ${colors.border}`}>
            <div class={`w-14 h-14 ${colors.bg} rounded-xl flex items-center justify-center mb-6 transition-colors duration-300 ${colors.bgHover}`}>
              {service.icon === "rocket" && (
                <svg class={`w-7 h-7 ${colors.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
                </svg>
              )}
              {service.icon === "server" && (
                <svg class={`w-7 h-7 ${colors.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                </svg>
              )}
              {service.icon === "link" && (
                <svg class={`w-7 h-7 ${colors.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
              )}
              {service.icon === "lightbulb" && (
                <svg class={`w-7 h-7 ${colors.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-semibold mb-3">{service.title}</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-4">
              {service.description}
            </p>
            <ul class="text-sm text-gray-500 space-y-2">
              {service.features.map((feature) => (
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</section>
